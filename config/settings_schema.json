[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
   {
    "name": "Theme Settings",
    "settings": [
      {
        "type": "color",
        "id": "body_background_color",
        "label": "Body Background Color",
        "default": "rgba(0, 0, 0, 0)"
      },
      {
        "type": "image_picker",
        "id": "body_background_image",
        "label": "Body Background Image"
      },
      {
        "type": "select",
        "id": "background_size",
        "label": "Background Image Size",
        "options": [
          {
            "value": "cover",
            "label": "Cover"
          },
          {
            "value": "contain",
            "label": "Contain"
          },
          {
            "value": "auto",
            "label": "Auto"
          }
        ],
        "default": "cover"
      },
      {
        "type": "select",
        "id": "background_position",
        "label": "Background Position",
        "options": [
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "top",
            "label": "Top"
          },
          {
            "value": "bottom",
            "label": "Bottom"
          }
        ],
        "default": "center"
      }
    ]
  },

{
  "name": "t:general.logo_and_favicon",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.manage_store_name"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:labels.default_logo"
    },
    {
      "type": "image_picker",
      "id": "logo_inverse",
      "label": "t:labels.logo_inverse",
      "info": "t:content.inverse_logo_info"
    },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:labels.favicon"
      }
  ]
},
 {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color_palette",
        "id": "color_palette",
        "default": {
          "background": "#ffffff",
          "foreground": "#000000"
        }
      }
    ]
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "color",
        "id": "page_text_color",
        "label": "t:labels.page_text_color",
        "default": "{{ settings.color_palette.foreground }}",
        "info": "t:content.page_text_color_default_info"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "playfair_display_n4",
        "label": "t:general.primary"
      },
      {
        "type": "font_picker",
        "id": "type_label_font",
        "default": "plus_jakarta_sans_n4",
        "label": "t:general.label_font"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  }
]
