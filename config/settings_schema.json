  {
    "name": "Global",
    "settings": [
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "checkbox",
        "id": "enable_animations",
        "label": "Enable animations",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_hover_effects",
        "label": "Enable hover effects",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_reduced_motion",
        "label": "Respect reduced motion preferences",
        "default": true
      },

      {
        "type": "header",
        "content": "Page layout"
      },
      {
        "type": "range",
        "id": "max_page_width_px",
        "min": 1000,
        "max": 1800,
        "step": 20,
        "unit": "px",
        "label": "Maximum page width",
        "default": 1440
      },
      {
        "type": "range",
        "id": "page_horizontal_padding",
        "min": 10,
        "max": 80,
        "step": 2,
        "unit": "px",
        "label": "Page horizontal padding",
        "default": 24
      },
      {
        "type": "range",
        "id": "section_spacing",
        "min": 0,
        "max": 160,
        "step": 4,
        "unit": "px",
        "label": "Section spacing",
        "default": 64
      },
      {
        "type": "range",
        "id": "grid_gap",
        "min": 4,
        "max": 60,
        "step": 2,
        "unit": "px",
        "label": "Grid gap",
        "default": 24
      },

      {
        "type": "header",
        "content": "Global shape"
      },
      {
        "type": "range",
        "id": "global_radius",
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "px",
        "label": "Global corner radius",
        "default": 20
      },
      {
        "type": "range",
        "id": "small_radius",
        "min": 0,
        "max": 30,
        "step": 1,
        "unit": "px",
        "label": "Small corner radius",
        "default": 12
      }
