<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">

    {% render 'css-variables' %}

 
    {% unless settings.type_primary_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

      {% comment %} Preload the base font variant for initial page render {% endcomment %}
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {% unless settings.type_label_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

      {% comment %} Preload the secondary font variant for initial page render {% endcomment %}
      {{ settings.type_label_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}
     <title>{{ page_title }}</title>
    {{ content_for_header }}

  </head>
<style>
  html,
  body {
    min-height: 100%;
  }

  body {
    margin: 0;

    {% if settings.background_mode == 'color' %}
      background-color: {{ settings.background_color }};
    {% else %}
      background-color: transparent;
    {% endif %}
  }

  .site-background {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;

    {% if settings.body_background_image %}
      background-image: url('{{ settings.body_background_image | image_url: width: 2400 }}');
      background-repeat: no-repeat;
      background-size: {{ settings.background_size }};
      background-position: {{ settings.background_position }};
    {% endif %}

    {% if settings.enable_background_blur %}
      filter: blur({{ settings.background_blur_amount }}px);
      transform: scale(1.04);
    {% endif %}
  }

  .site-content {
    position: relative;
    z-index: 1;
  }
</style>
  <body>

    {% sections 'announcement-bar' %}

    {% sections 'header-group' %}

    <main>
      
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% comment %} <script src="{{ 'theme.js' | asset_url }}"defer></script> {% endcomment %}
  </body>
</html>
