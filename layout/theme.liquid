<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">

    {% render 'css-variables' %}

 
    {% unless settings.type_primary_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

      {% comment %} Preload the base font variant for initial page render {% endcomment %}
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}


    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}
     <title>{{ page_title }}</title>
    {{ content_for_header }}

  </head>

<body>

  <div
    class="site-background"
    aria-hidden="true"
    style="
      --site-background-color: {{ settings.body_background_color }};
      --site-background-image: {% if settings.body_background_image %}url('{{ settings.body_background_image | image_url: width: 2400 }}'){% else %}none{% endif %};
      --site-background-size: {{ settings.background_size }};
      --site-background-position: {{ settings.background_position }};
      --site-background-blur: {% if settings.background_blur_enabled %}{{ settings.background_blur }}px{% else %}0px{% endif %};
      --site-background-overlay: {{ settings.background_overlay_opacity | default: 0 }}%;
    "
  ></div>

  {% sections 'announcement-bar' %}

  {% sections 'header-group' %}

  <main>
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

</body>
</html>
