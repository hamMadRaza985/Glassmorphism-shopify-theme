<section class="section page-width">
  <div class="section-top">
    <div style="width:100%">
      <div class="section-heading"><span class="eyebrow">{{ section.settings.eyebrow }}</span></div>
      <h2 class="section-title">{{ section.settings.heading }}</h2>
    </div>
    {% if section.settings.collection != blank %}
      <a class="view-all" href="{{ section.settings.collection.url }}">View All <span>→</span></a>
    {% endif %}
  </div>
  <div class="products">
    {% assign collection = section.settings.collection %}
    {% if collection != blank %}
      {% for product in collection.products limit: section.settings.products_to_show %}
        <article class="product-card">
          <a href="{{ product.url }}">
            <div class="product-media">
              {% if product.featured_image %}
                {{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: product.title }}
              {% endif %}
              {% if product.tags contains 'New' %}<span class="badge">New</span>{% elsif product.tags contains 'Best Seller' %}<span class="badge">Best Seller</span>{% endif %}
            </div>
            <div class="product-info">
              <h3 class="product-title">{{ product.title }}</h3>
              <div class="price-row"><span class="price">{{ product.price | money }}</span><span class="add-cart">🛒</span></div>
            </div>
          </a>
        </article>
      {% endfor %}
    {% else %}
      {% for i in (1..5) %}
        <article class="product-card"><div class="product-media"><div style="width:120px;height:150px;border-radius:50%;background:linear-gradient(145deg,#d4b078,#171717 45%,#090909);box-shadow:0 0 40px #000"></div><span class="badge">{% if i == 2 or i == 4 %}Best Seller{% else %}New{% endif %}</span></div><div class="product-info"><h3 class="product-title">Andri Watch {{ i | prepend: '0' }}</h3><div class="price-row"><span class="price">Rs. {{ i | times: 1000 | plus: 11999 }}</span><span class="add-cart">🛒</span></div></div></article>
      {% endfor %}
    {% endif %}
  </div>
</section>
{% schema %}
{"name":"Best sellers","settings":[
{"type":"text","id":"eyebrow","label":"Eyebrow","default":"BEST SELLERS"},
{"type":"text","id":"heading","label":"Heading","default":"Our Most Loved Watches"},
{"type":"collection","id":"collection","label":"Collection"},
{"type":"range","id":"products_to_show","label":"Products","min":2,"max":10,"step":1,"default":5}
],"presets":[{"name":"Best sellers"}]}
{% endschema %}