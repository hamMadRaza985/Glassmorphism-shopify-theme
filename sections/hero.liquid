<section class="andri-shell">
  <div class="hero">
    <div class="hero-media">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 2200 | image_tag: loading: 'eager', widths: '800,1200,1600,2200', alt: section.settings.heading }}
      {% else %}
        <div style="width:100%;height:100%;background:radial-gradient(circle at 65% 45%,#624323 0,#191512 28%,#050505 70%)"></div>
      {% endif %}
    </div>
    <div class="page-width">
      <div class="hero-content">
        <div class="eyebrow">{{ section.settings.eyebrow }}</div>
        <h1>{{ section.settings.heading }} <em>{{ section.settings.heading_accent }}</em></h1>
        <p>{{ section.settings.text }}</p>
        {% if section.settings.button_label != blank %}
          <a class="gold-btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label }} <span>→</span></a>
        {% endif %}
      </div>
    </div>
    <button class="slider-arrow left" aria-label="Previous">‹</button>
    <button class="slider-arrow right" aria-label="Next">›</button>
    <div class="dots"><span class="dot active"></span><span class="dot"></span><span class="dot"></span></div>
  </div>
</section>
{% schema %}
{
  "name":"Hero",
  "settings":[
    {"type":"image_picker","id":"image","label":"Hero image"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"TIMELESS ELEGANCE"},
    {"type":"text","id":"heading","label":"Heading","default":"More Than Just"},
    {"type":"text","id":"heading_accent","label":"Accent heading","default":"A Watch"},
    {"type":"textarea","id":"text","label":"Text","default":"A symbol of your style, your story, and your time."},
    {"type":"text","id":"button_label","label":"Button label","default":"Shop Now"},
    {"type":"url","id":"button_link","label":"Button link"}
  ],
  "presets":[{"name":"Andri hero"}]
}
{% endschema %}