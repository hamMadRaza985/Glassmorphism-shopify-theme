<header class="site-header glass">
  <div class="header-inner">
    <button class="icon-btn mobile-menu" data-menu-toggle aria-label="Toggle menu" aria-expanded="false">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
    <a class="brand" href="{{ routes.root_url }}">
      {% if section.settings.logo != blank %}
        <img src="{{ section.settings.logo | image_url: width: 240 }}" alt="{{ shop.name }}" style="max-width:150px;max-height:48px;object-fit:contain">
      {% else %}
        <span class="brand-mark">A</span>
        <span class="brand-copy"><strong>{{ section.settings.logo_text }}</strong><span>{{ section.settings.tagline }}</span></span>
      {% endif %}
    </a>
    <nav class="nav" aria-label="Main navigation">
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title }}</a>
      {% endfor %}
    </nav>
    <div class="header-actions">
      <a class="icon-btn" href="{{ routes.search_url }}" aria-label="Search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg>
      </a>
      <a class="icon-btn" href="{{ routes.account_url }}" aria-label="Account">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="8" r="3.2"/><path d="M5 20c.7-4 3-6 7-6s6.3 2 7 6"/></svg>
      </a>
      <a class="icon-btn" href="{{ routes.cart_url }}" aria-label="Cart" style="position:relative">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 4h2l2.1 11.3a2 2 0 0 0 2 1.7h7.8a2 2 0 0 0 2-1.6L21 8H6"/><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg>
        {% if cart.item_count > 0 %}<span class="cart-count">{{ cart.item_count }}</span>{% endif %}
      </a>
    </div>
  </div>
  <div class="mobile-nav glass" style="display:none;padding:12px;margin-top:8px;border-radius:12px">
    {% for link in section.settings.menu.links %}<a href="{{ link.url }}" style="display:block;padding:10px 4px;font-size:13px">{{ link.title }}</a>{% endfor %}
  </div>
</header>
<style>
.mobile-nav-open .mobile-nav{display:block!important}
@media(min-width:901px){.mobile-nav{display:none!important}}
</style>
{% schema %}
{
  "name": "Header",
  "settings": [
    {"type":"image_picker","id":"logo","label":"Logo"},
    {"type":"text","id":"logo_text","label":"Logo text","default":"ANDRI"},
    {"type":"text","id":"tagline","label":"Tagline","default":"WATCHES STORE"},
    {"type":"link_list","id":"menu","label":"Menu","default":"main-menu"}
  ]
}
{% endschema %}