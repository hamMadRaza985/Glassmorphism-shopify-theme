<section class="section page-width">
  <div class="categories">
    {% for block in section.blocks %}
      <a class="category" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.title }}
        {% endif %}
        <div class="category-content"><h3>{{ block.settings.title }}</h3><span class="category-link">{{ block.settings.link_text }} →</span></div>
      </a>
    {% endfor %}
  </div>
</section>
{% schema %}
{"name":"Category cards","max_blocks":4,"blocks":[
{"type":"category","name":"Category","settings":[
{"type":"image_picker","id":"image","label":"Image"},
{"type":"text","id":"title","label":"Title","default":"Men's Watches"},
{"type":"text","id":"link_text","label":"Link text","default":"Shop Now"},
{"type":"url","id":"link","label":"Link"}]}],
"presets":[{"name":"Category cards","blocks":[
{"type":"category","settings":{"title":"Men's Watches","link_text":"Shop Now"}},
{"type":"category","settings":{"title":"Women's Watches","link_text":"Shop Now"}},
{"type":"category","settings":{"title":"Wallets","link_text":"Shop Now"}},
{"type":"category","settings":{"title":"Gift Sets","link_text":"Shop Now"}}
]}]}
{% endschema %}