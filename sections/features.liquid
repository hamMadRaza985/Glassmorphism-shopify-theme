<div class="page-width feature-bar glass">
  <div class="features">
    {% for block in section.blocks %}
      <div class="feature" {{ block.shopify_attributes }}>
        <div class="feature-icon">{{ block.settings.icon }}</div>
        <div><strong>{{ block.settings.title }}</strong><span>{{ block.settings.text }}</span></div>
      </div>
    {% endfor %}
  </div>
</div>
{% schema %}
{"name":"Trust features","max_blocks":4,"blocks":[
{"type":"feature","name":"Feature","settings":[
{"type":"text","id":"icon","label":"Icon / symbol","default":"♢"},
{"type":"text","id":"title","label":"Title","default":"100% Original Products"},
{"type":"text","id":"text","label":"Text","default":"Guaranteed Authenticity"}]}],
"presets":[{"name":"Trust features","blocks":[
{"type":"feature","settings":{"icon":"♢","title":"100% Original Products","text":"Guaranteed Authenticity"}},
{"type":"feature","settings":{"icon":"▣","title":"Fast & Secure Shipping","text":"Across Pakistan & Worldwide"}},
{"type":"feature","settings":{"icon":"♢","title":"Secure Payments","text":"Shop with Confidence"}},
{"type":"feature","settings":{"icon":"◯","title":"Dedicated Support","text":"We're Here to Help"}}
]}]}
{% endschema %}