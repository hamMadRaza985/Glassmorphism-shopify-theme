<div
  class="announcement-bar announcement-bar--{{ section.settings.style }}"
  style="
    --announcement-bg: {{ section.settings.background_color }};
    --announcement-bg-opacity: {{ section.settings.background_opacity | divided_by: 100.0 }};
    --announcement-text: {{ section.settings.text_color }};
    --announcement-border: {{ section.settings.border_color }};
    --announcement-border-opacity: {{ section.settings.border_opacity | divided_by: 100.0 }};
    --announcement-blur: {{ section.settings.blur }}px;
    --announcement-height: {{ section.settings.height }}px;
    --announcement-font-size: {{ section.settings.font_size }}px;
    --announcement-radius: {{ section.settings.radius }}px;
  "
>
  <div class="announcement-bar__inner">

    {% if section.settings.show_icon %}
      <span class="announcement-bar__icon" aria-hidden="true">
        {{ section.settings.icon }}
      </span>
    {% endif %}

    {% if section.settings.link != blank %}
      <a
        href="{{ section.settings.link }}"
        class="announcement-bar__link"
      >
    {% endif %}

      <div class="announcement-bar__text">
        {{ section.settings.text }}
      </div>

    {% if section.settings.link != blank %}
      </a>
    {% endif %}

  </div>
</div>

{% stylesheet %}

.announcement-bar {
  position: relative;
  z-index: 100;
  width: 100%;
  min-height: var(--announcement-height);

  display: flex;
  align-items: center;
  justify-content: center;

  color: var(--announcement-text);

  overflow: hidden;
}

.announcement-bar--glass {
  background: color-mix(
    in srgb,
    var(--announcement-bg) calc(var(--announcement-bg-opacity) * 100%),
    transparent
  );

  border-bottom: 1px solid color-mix(
    in srgb,
    var(--announcement-border) calc(var(--announcement-border-opacity) * 100%),
    transparent
  );

  backdrop-filter: blur(var(--announcement-blur));
  -webkit-backdrop-filter: blur(var(--announcement-blur));
}

.announcement-bar--solid {
  background: var(--announcement-bg);
}

.announcement-bar--transparent {
  background: transparent;

  border-bottom: 1px solid color-mix(
    in srgb,
    var(--announcement-border) calc(var(--announcement-border-opacity) * 100%),
    transparent
  );

  backdrop-filter: blur(var(--announcement-blur));
  -webkit-backdrop-filter: blur(var(--announcement-blur));
}

.announcement-bar__inner {
  width: 100%;
  min-height: var(--announcement-height);

  display: flex;
  align-items: center;
  justify-content: center;

  gap: 8px;

  padding: 8px 20px;

  text-align: center;
}

.announcement-bar__text {
  font-size: var(--announcement-font-size);
  line-height: 1.4;
  font-weight: 500;
  letter-spacing: 0.02em;
}

.announcement-bar__link {
  color: inherit;
  text-decoration: none;
}

.announcement-bar__link:hover .announcement-bar__text {
  text-decoration: underline;
}

.announcement-bar__icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  font-size: 16px;
  line-height: 1;
}

/* Subtle glass highlight */
.announcement-bar--glass::before {
  content: "";
  position: absolute;
  inset: 0;

  pointer-events: none;

  background: linear-gradient(
    180deg,
    rgb(255 255 255 / 0.12),
    transparent 60%
  );
}

/* Mobile */
@media screen and (max-width: 749px) {

  .announcement-bar__inner {
    padding: 7px 14px;
  }

  .announcement-bar__text {
    font-size: max(11px, calc(var(--announcement-font-size) - 1px));
  }

}

{% endstylesheet %}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Announcement text",
      "default": "Free shipping on all orders"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Announcement link"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        {
          "value": "glass",
          "label": "Glass"
        },
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "transparent",
          "label": "Transparent"
        }
      ],
      "default": "glass"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "background_opacity",
      "label": "Background opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 35
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "label": "Border opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 25
    },
    {
      "type": "range",
      "id": "blur",
      "label": "Glass blur",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "height",
      "label": "Bar height",
      "min": 24,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 38
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show icon",
      "default": false
    },
    {
      "type": "text",
      "id": "icon",
      "label": "Icon",
      "default": "✦"
    }
  ]
}
{% endschema %}