<section class="section page-width">
  <div class="premium">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', alt: section.settings.heading }}
    {% endif %}
    <div class="premium-content">
      <div class="eyebrow">{{ section.settings.eyebrow }}</div>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      {% if section.settings.button_label != blank %}<a class="gold-btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label }} →</a>{% endif %}
    </div>
  </div>
</section>
{% schema %}
{"name":"Premium banner","settings":[
{"type":"image_picker","id":"image","label":"Image"},
{"type":"text","id":"eyebrow","label":"Eyebrow","default":"PREMIUM QUALITY"},
{"type":"text","id":"heading","label":"Heading","default":"Crafted for Those Who Value Time."},
{"type":"textarea","id":"text","label":"Text","default":"Elegant watches. Timeless style. Only at Andri Watches Store."},
{"type":"text","id":"button_label","label":"Button label","default":"Explore Collection"},
{"type":"url","id":"button_link","label":"Button link"}],
"presets":[{"name":"Premium banner"}]}
{% endschema %}